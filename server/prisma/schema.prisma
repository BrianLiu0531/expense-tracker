generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Region {
  AU
  NZ
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  region       Region        @default(AU)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          TransactionType
  /// Stored in cents to avoid floating point rounding errors
  amountCents   Int
  category      String
  description   String?
  date          DateTime        @db.Date
  /// True when the amount is GST-inclusive (used for GST reporting)
  gstApplicable Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, date])
}
